# Gateway HTTP listen port (or override explicitly with LISTEN_ADDR)
PORT=8080
# LISTEN_ADDR=:8080
# Optional Redis host:port for distributed Lua rate limiting (blank uses in-memory limiter)
REDIS_ADDR=
# Optional Redis AUTH password
REDIS_PASSWORD=
# Upstream pool targets (`url|weight,url2|weight2`); omit to run built-in demo upstream pool
UPSTREAM_URLS=
UPSTREAM_URL=
UPSTREAM_STRATEGY=weighted
# Admin API key protecting /v1/admin/* endpoints
ADMIN_API_KEY=replace_with_32byte_admin_key
# Optional initial tenant key seeded on startup
GATEWAY_DEMO_API_KEY=replace_with_demo_tenant_key
# Comma-separated allowed CORS origins for browser control plane requests
ALLOWED_ORIGINS=https://gateway.example.com
# Active /health probe interval
HEALTH_CHECK_INTERVAL=5s
